{
 "id": "H0107",
 "market": "US",
 "derive": {
  "pc": "lag(close, 1)",
  "tr": "np.maximum(high - low, np.maximum(np.abs(high - pc), np.abs(low - pc)))",
  "atr40": "rma(tr, 40)",
  "vavg": "lag(rmean(volume, 50), 1)"
 },
 "cond": "((open - pc) >= 0.75 * lag(atr40, 1)) & (volume >= 1.5 * vavg)",
 "holds": [
  10,
  20,
  40
 ],
 "main_hold": 20,
 "variants": [
  {
